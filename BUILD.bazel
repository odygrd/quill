load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(":quill_module.bzl", "quill_module")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # MIT

cc_library(
    name = "quill",
    hdrs = glob(["include/**/*.h"]),
    copts = select({
        "@rules_cc//cc/compiler:gcc": ["-Wno-gnu-zero-variadic-macro-arguments"],
        "@rules_cc//cc/compiler:clang": ["-Wno-gnu-zero-variadic-macro-arguments"],
        "//conditions:default": [],
    }),
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [],
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": ["-lpthread"],
    }),
)

cc_library(
    name = "fmtquill",
    hdrs = glob(["include/quill/bundled/fmt/*.h"]),
    includes = ["include"],
)

quill_module(
    name = "quill_module",
    copts = select({
        "@rules_cc//cc/compiler:gcc": ["-Wno-gnu-zero-variadic-macro-arguments"],
        "@rules_cc//cc/compiler:clang": ["-Wno-gnu-zero-variadic-macro-arguments"],
        "//conditions:default": [],
    }),
    # rules_cc 0.2.22 uses the same module metadata path for PIC and non-PIC outputs.
    features = [
        "cpp_modules",
        "prefer_pic_for_opt_binaries",
    ],
    module_interfaces = ["src/quill.cc"],
    # Prevent users without --experimental_cpp_modules support from accidentally building this
    tags = ["manual"],
    deps = [":quill"],
)
